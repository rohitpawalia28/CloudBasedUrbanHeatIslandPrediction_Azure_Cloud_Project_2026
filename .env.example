# Copy this file to .env and adjust. .env is git-ignored - never commit real secrets.

# emulated = every AWS service runs locally (default, no AWS account needed)
# aws      = also mirror S3 objects and SNS messages to a real AWS account (needs boto3 + AWS credentials)
CLOUD_MODE=emulated
AWS_REGION=ap-south-1
S3_BUCKET=uhi-geoai-data-lake

HOST=127.0.0.1
PORT=5000
SECRET_KEY=change-this-to-a-long-random-string

# Seed admin user of the Cognito user pool
ADMIN_EMAIL=admin@uhi.cloud
ADMIN_PASSWORD=Admin@123

# UHI threshold (deg C) for SNS heat alerts, and API Gateway usage-plan limit
ALERT_THRESHOLD=5.0
API_RATE_LIMIT_PER_MIN=120
